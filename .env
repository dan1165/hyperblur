# hyperblur configuration. `docker compose` reads this file automatically.

# Media delivery.
#   true  = proxy every image/video/audio through hyperblur.
#           Zero CDN. Tumblr never sees the viewer's IP. Uses more of your
#           server's bandwidth and CPU.
#   false = load media straight from Tumblr's CDN.
#           Faster and lighter on your server. Tumblr sees the viewer's IP.
HYPERBLUR_PROXY_MEDIA=true

# Optional: your own Tumblr API token. Empty uses the bundled one.
# Needed to open blogs that require a login.
HYPERBLUR_TUMBLR_API_TOKEN=

# Optional: port to listen on (default 8000).
# HYPERBLUR_PORT=8000
