# Optional openblur environment variables.
#
# Copy this file to `.env` and fill in the values you need. All variables are
# optional; openblur falls back to sensible defaults when they are unset.

# Custom Tumblr API bearer token.
#
# Supplying a token tied to a logged-in Tumblr account lets openblur access
# blogs that require logging in. Leave empty (or unset) to use openblur's
# bundled default token.
#
# Only the raw token is needed; a leading "Bearer " is accepted too.
OPENBLUR_TUMBLR_API_TOKEN=
