# Optional Priviblur environment variables.
#
# Copy this file to `.env` and fill in the values you need. All variables are
# optional; Priviblur falls back to sensible defaults when they are unset.

# Custom Tumblr API bearer token.
#
# Supplying a token tied to a logged-in Tumblr account lets Priviblur access
# blogs that require logging in. Leave empty (or unset) to use Priviblur's
# bundled default token.
#
# Only the raw token is needed; a leading "Bearer " is accepted too.
PRIVIBLUR_TUMBLR_API_TOKEN=
